@article{Ruiz-Marn2024,
   abstract = {Scope: This work is part of the clinical study NCT03885648 registered in ClinicalTrials.gov, aimed at studying the relationship among breast cancer, microbiota, and exposure to environmental pollutants. As a first step, we characterized and evaluated risk factors of the participants. Methods and results: A case–control study was designed with breast cancer (cases, n = 122) and healthy women (controls, n = 56) recruited in two hospitals of Andalusia (Southern Spain). Participants answered questionnaires of Mediterranean diet adherence and food frequency. Data were collected from medical histories and microbiota was analyzed on stool samples. Most cases (78.2%) were diagnosed as stages I and II. Cases had higher age, body mass index (BMI), glucose, cholesterol, and potassium values than controls. Cases exhibited higher adherence to the Mediterranean diet and their food consumption was closer to that dietary pattern. A hierarchical cluster analysis revealed that the Bacillota/Bacteroidota ratio was the most relevant variable in women with breast cancer, which was higher in this group compared with controls. Conclusion: Although cases exhibited higher adherence to the Mediterranean diet compared with controls, they presented features and microbiota alterations typical of the metabolic syndrome, probably due to their higher BMI and reflecting changes in their lifestyle around the time of diagnosis.},
   author = {Carmen María Ruiz-Marín and Ana Isabel Álvarez-Mercado and Julio Plaza-Díaz and Avilene Rodríguez-Lara and Tania Gallart-Aragón and María Teresa Sánchez-Barrón and Saturnino de Reyes Lartategui and Miriam Alcaide-Lucena and Mariana F. Fernández and Luis Fontana},
   doi = {10.1002/mnfr.202400253},
   issn = {16134133},
   issue = {15},
   journal = {Molecular Nutrition and Food Research},
   keywords = {Bacillota/Bacteroidota ratio,Mediterranean diet,breast cancer,gut microbiota},
   month = {8},
   pmid = {38950423},
   publisher = {John Wiley and Sons Inc},
   title = {A Clustering Study of Sociodemographic Data, Dietary Patterns, and Gut Microbiota in Healthy and Breast Cancer Women Participating in the MICROMA Study},
   volume = {68},
   year = {2024}
}

